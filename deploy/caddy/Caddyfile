# /etc/caddy/Caddyfile - reverse proxy in front of synect-api (127.0.0.1:5299).
#
# THE ONE LINE TO CHANGE is the `import` at the very bottom:
#   no domain:         import synect_by_ip
#                      plain HTTP on the server IP, only /health and /ready are published, everything else 404.
#   with a domain (now, since 2026-11-19): import synect_with_domain api.synect.uz
#                      automatic HTTPS (Let's Encrypt), HTTP -> HTTPS redirect, /mcp and /ingest/1c/v1/* published too.
# Then: caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
#
# /version, /mcp without a domain and every other path stay closed (404); they are reachable through an SSH tunnel:
#   ssh -L 5299:127.0.0.1:5299 root@<server>   ->   http://127.0.0.1:5299/...

{
	# Admin API on the loopback only (used by `systemctl reload caddy`).
	admin localhost:2019
}

# Public paths and the access log, shared by both modes.
(synect_common) {
	@health path /health /ready
	handle @health {
		reverse_proxy 127.0.0.1:5299
	}

	log {
		output file /var/log/caddy/synect-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				# Never log credentials (Caddy also redacts them by default; this keeps it explicit).
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Proxy-Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# No domain yet: plain HTTP on any address of the server, no automatic HTTPS.
(synect_by_ip) {
	http:// {
		import synect_common
		handle {
			respond 404
		}
	}
}

# With a domain (argument): HTTPS with an automatic certificate; MCP and the 1C receiver are published.
(synect_with_domain) {
	{args[0]} {
		import synect_common
		encode zstd gzip
		handle /mcp {
			reverse_proxy 127.0.0.1:5299
		}
		handle /ingest/1c/v1/* {
			request_body {
				max_size 4MB
			}
			reverse_proxy 127.0.0.1:5299
		}
		handle {
			respond 404
		}
	}
}

import synect_with_domain api.synect.uz

# ---------------------------------------------------------------------------------------------------------------
# Static site synect.uz (published by synect-site\deploy\deploy.ps1 into /var/www/synect/releases; Caddy reads
# /var/www/synect/current only). Only white-listed paths are served; addresses keep .html; "/" serves synect.html.

# HTTP -> HTTPS and www -> synect.uz as explicit 301 (Caddy's own automatic redirect would be 308).
http://synect.uz, http://www.synect.uz {
	redir https://synect.uz{uri} 301
}

www.synect.uz {
	header Strict-Transport-Security "max-age=300"
	redir https://synect.uz{uri} 301
}

synect.uz {
	root * /var/www/synect/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# HSTS: short trial value first; raise only after a few days without problems.
		Strict-Transport-Security "max-age=300"
	}

	@pages path / /synect.html /synect-uz.html /voprosy.html /savollar.html /stati.html /sverka-platezhey-s-esf.html /neoplachennye-esf.html /esf-didox-ozhidayut-podpisi.html /ostatok-banka-ne-shoditsya-s-1s.html /dolgi-klientov-30-60-90.html /platezhi-bez-dokumentov.html /chek-list-zakrytiya-mesyaca.html /404.html
	@meta path /sitemap.xml /robots.txt /yandex_332872da88824a2a.html /googlec04d433c7a384d9e.html
	@assets path_regexp ^/assets/[A-Za-z0-9._-]+\.(webp|png|jpg|jpeg|svg|avif|gif|ico)$
	@icons path /favicon.ico /favicon.svg /apple-touch-icon.png

	# html 5 minutes
	handle @pages {
		header Cache-Control "public, max-age=300"
		rewrite / /synect.html
		file_server
	}
	handle @meta {
		header Cache-Control "public, max-age=300"
		file_server
	}
	# icons: 1 day
	handle @icons {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# assets/: file names carry no hash, so 1 day
	handle @assets {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# everything else (drafts, backups, *.md, *.py, .git, unknown pages): 404
	handle {
		error 404
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			header Cache-Control "public, max-age=300"
			rewrite * /404.html
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}"
		}
	}

	log {
		output file /var/log/caddy/synect-site-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
