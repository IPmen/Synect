[Unit]
Description=Synect sync worker (queue of loads from banks and Didox)
Documentation=file:///opt/synect/current/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=notify
User=synect
Group=synect
WorkingDirectory=/opt/synect/current/worker
ExecStart=/opt/synect/current/worker/Synect.Worker
EnvironmentFile=/etc/synect/synect.env
Environment=DOTNET_ENVIRONMENT=Production
Environment=HOME=/var/lib/synect
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

Restart=always
RestartSec=5
# Graceful stop: running loads get 45 s to finish, the rest go back to the queue, all within 60 s.
KillSignal=SIGTERM
TimeoutStopSec=75
TimeoutStartSec=60

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/synect
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G

[Install]
WantedBy=multi-user.target
