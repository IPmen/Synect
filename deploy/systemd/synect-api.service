[Unit]
Description=Synect API (MCP, 1C receiver, /health, /ready)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=notify
User=synect
Group=synect
WorkingDirectory=/opt/synect/current/api
ExecStart=/opt/synect/current/api/Synect.Api
# Connection string (synect_app) and other secrets; root-owned, mode 600, read by systemd before dropping privileges.
EnvironmentFile=/etc/synect/synect.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
# Loopback only: Caddy is the only way in.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5299
Environment=HOME=/var/lib/synect
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

Restart=always
RestartSec=5
# Graceful stop: the host waits up to Hosting:ShutdownTimeout (60 s) for in-flight requests.
KillSignal=SIGTERM
TimeoutStopSec=75
TimeoutStartSec=60

# Hardening (the .NET JIT needs writable+executable memory, so MemoryDenyWriteExecute stays off).
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/synect
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# ProtectProc=invisible would hide /proc/1 and .NET would not detect systemd (no READY=1 for Type=notify, no journald format).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G

[Install]
WantedBy=multi-user.target
