#!/usr/bin/env bash
# Checks that a backup can be restored: pg_restore of a dump into a temporary database synect_restore_check, then
# row counts of every table compared with the live database and a check that the key archive unpacks.
# The temporary database is left in place; drop it with --drop when done.
#
#   synect-restore-test [/var/backups/synect/synect-db-....dump]   (default: newest dump)
#   synect-restore-test --drop                                     drop synect_restore_check
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run as root" >&2; exit 1; }

DIR=/var/backups/synect
TMPDB=synect_restore_check
psql_pg() { runuser -u postgres -- psql -X -v ON_ERROR_STOP=1 -qAt "$@"; }

if [[ "${1:-}" == "--drop" ]]; then
  psql_pg -c "DROP DATABASE IF EXISTS $TMPDB WITH (FORCE)"
  echo "dropped $TMPDB"; exit 0
fi

dump=${1:-$(ls -t "$DIR"/synect-db-*.dump | head -1)}
stamp=$(basename "$dump" .dump); stamp=${stamp#synect-db-}
echo "dump: $dump"
( cd "$DIR" && sha256sum -c "synect-$stamp.sha256" )

if [[ -n "$(psql_pg -c "SELECT 1 FROM pg_database WHERE datname = '$TMPDB'")" ]]; then
  echo "$TMPDB already exists: run synect-restore-test --drop first" >&2; exit 1
fi
psql_pg -c "CREATE DATABASE $TMPDB OWNER synect_owner"
runuser -u postgres -- pg_restore --exit-on-error --no-owner --role=synect_owner --dbname="$TMPDB" < "$dump"

counts() { # every public table with its exact row count
  psql_pg -d "$1" -c "SELECT string_agg(format('SELECT %L AS t, count(*) AS n FROM public.%I', tablename, tablename), ' UNION ALL ' ORDER BY tablename) FROM pg_tables WHERE schemaname = 'public'" \
    | { read -r q; psql_pg -d "$1" -F' ' -c "$q ORDER BY 1"; }
}
diff <(counts synect) <(counts "$TMPDB") > /tmp/synect-restore-diff.txt && same=yes || same=no
tables=$(counts "$TMPDB" | wc -l); rows=$(counts "$TMPDB" | awk '{s+=$2} END {print s}')
echo "restored: $tables tables, $rows rows; equal to the live database: $same"
[[ $same == yes ]] || { echo "(differences, e.g. writes since the dump:)"; head -20 /tmp/synect-restore-diff.txt; }

keys=$DIR/synect-keys-$stamp.tar.gz
echo "keys archive: $(tar -tzf "$keys" | grep -c '\.xml$') key file(s)"
echo "temporary database $TMPDB kept; drop it with: synect-restore-test --drop"
