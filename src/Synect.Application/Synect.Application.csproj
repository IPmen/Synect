<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Synect.Domain\Synect.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Base EF Core package only (no provider): Application talks to ISynectDbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- SqlQuery for analytics aggregates (provider-neutral API; the SQL itself targets PostgreSQL). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>
  <ItemGroup>
    <!-- Words of payment purposes (Russian, Uzbek); easy to extend without code changes. -->
    <EmbeddedResource Include="Reconciliation\PurposeDictionary.json" LogicalName="Synect.Reconciliation.PurposeDictionary.json" />
    <!-- Mapping profiles of the 1C:Fresh OData connector (data, not code): Synect.OData.Profiles.<name>.json. -->
    <EmbeddedResource Include="OData\Profiles\*.json" LogicalName="Synect.OData.Profiles.%(Filename).json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Synect.Tests" />
  </ItemGroup>
</Project>
