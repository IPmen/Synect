{
  // Starting profile of the 1C:Fresh OData connector, built from docs/mapping.md of the 1C extension (names of the
  // training "Бухгалтерия предприятия" 3.0.111). NOT checked on a real Uzbek application yet: every name, filter and
  // transform marked "verify": true must be checked against $metadata of the client's application (probe-odata).
  "name": "clobus-bp-uz",
  "description": "Бухгалтерия (узбекская конфигурация на 1С:Фреш / Clobus): контрагенты, договоры, банковские счета организации, реализация и поступление, банковские документы. Стартовый профиль, не проверен на настоящем приложении.",
  "key_property": "Ref_Key",
  "version_property": "DataVersion",
  "deletion_property": "DeletionMark",
  "entities": [
    {
      "entity": "counterparties",
      "sources": [
        {
          "resource": { "name": "Catalog_Контрагенты", "verify": true },
          "filter": { "value": "IsFolder eq false", "verify": true },
          "fields": {
            "name": { "source": "Description", "transform": "string", "verify": false },
            "full_name": { "source": "НаименованиеПолное", "transform": "string", "verify": true },
            "tin": { "source": "ИНН", "transform": "string", "verify": true },
            "kind": {
              "source": "ЮридическоеФизическоеЛицо", "transform": "enum", "verify": true,
              "map": { "ЮридическоеЛицо": "LegalEntity", "ФизическоеЛицо": "Individual" }
            }
          }
        }
      ]
    },
    {
      "entity": "contracts",
      "sources": [
        {
          "resource": { "name": "Catalog_ДоговорыКонтрагентов", "verify": true },
          "filter": { "value": "IsFolder eq false", "verify": true },
          "organization_filter": { "value": "Организация_Key eq {organization}", "verify": true },
          "fields": {
            "counterparty_ref": { "source": "Owner_Key", "transform": "ref", "verify": true },
            "number": { "source": "Номер", "fallback": "Description", "transform": "string", "verify": true },
            "date": { "source": "Дата", "transform": "date", "verify": true },
            "kind": {
              "source": "ВидДоговора", "transform": "enum", "verify": true,
              "map": { "СПокупателем": "Customer", "СПоставщиком": "Supplier" }, "map_default": "Other"
            },
            "currency": {
              "source": "ВалютаВзаиморасчетов_Key", "transform": "currency", "verify": true,
              "lookup": { "resource": "Catalog_Валюты", "properties": [ "Description", "Code" ] }
            },
            "valid_until": { "source": "СрокДействия", "transform": "date", "verify": true },
            "payment_term_days": { "source": "СрокОплаты", "transform": "int", "verify": true }
          }
        }
      ]
    },
    {
      "entity": "bank_accounts",
      "sources": [
        {
          "resource": { "name": "Catalog_БанковскиеСчета", "verify": true },
          "filter": { "value": "Owner_Type eq 'StandardODATA.Catalog_Организации'", "verify": true },
          "organization_filter": { "value": "Owner eq {organization}", "verify": true },
          "fields": {
            "number": { "source": "НомерСчета", "transform": "string", "verify": true },
            "bank_code": {
              "source": "Банк_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_Банки", "properties": [ "Code" ] }
            },
            "bank_name": {
              "source": "Банк_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_Банки", "properties": [ "Description" ] }
            },
            "currency": {
              "source": "ВалютаДенежныхСредств_Key", "transform": "currency", "verify": true,
              "lookup": { "resource": "Catalog_Валюты", "properties": [ "Description", "Code" ] }
            },
            "gl_account_code": {
              "source": "СчетБанк_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "ChartOfAccounts_Хозрасчетный", "properties": [ "Code" ] }
            },
            "is_active": { "source": "DeletionMark", "transform": "not", "verify": true }
          }
        }
      ]
    },
    {
      "entity": "documents",
      "sources": [
        {
          "resource": { "name": "Document_РеализацияТоваровУслуг", "verify": true },
          "date_property": { "name": "Date", "verify": false },
