            },
            "amount_total": { "source": "СуммаДокумента", "transform": "money", "verify": true },
            "vat_amount": {
              "transform": "money", "verify": true,
              "sum_of": [ { "table": "Товары", "property": "СуммаНДС" }, { "table": "Услуги", "property": "СуммаНДС" } ]
            },
            "comment": { "source": "Комментарий", "transform": "string", "max_length": 1000, "verify": true }
          },
          "children": {
            "name": "lines",
            "tables": [
              {
                "property": { "name": "Товары", "verify": true },
                "fields": {
                  "line_no": { "source": "LineNumber", "transform": "int", "verify": false },
                  "item_ref": { "source": "Номенклатура_Key", "transform": "ref", "verify": true },
                  "name": {
                    "source": "Номенклатура_Key", "transform": "string", "verify": true,
                    "lookup": { "resource": "Catalog_Номенклатура", "properties": [ "Description" ] }
                  },
                  "product_code": {
                    "source": "Номенклатура_Key", "transform": "string", "verify": true,
                    "lookup": { "resource": "Catalog_Номенклатура", "properties": [ "Артикул" ] }
                  },
                  "quantity": { "source": "Количество", "transform": "decimal", "verify": true },
                  "price": { "source": "Цена", "transform": "money", "verify": true },
                  "vat_rate": { "source": "СтавкаНДС", "transform": "vat_rate", "verify": true },
                  "amount": {
                    "source": "Сумма", "vat_source": "СуммаНДС", "header_flag": "СуммаВключаетНДС",
                    "transform": "amount_with_vat", "verify": true
                  }
                }
              },
              {
                "property": { "name": "Услуги", "verify": true },
                "fields": {
                  "line_no": { "source": "LineNumber", "transform": "int", "verify": false },
                  "item_ref": { "source": "Номенклатура_Key", "transform": "ref", "verify": true },
                  "name": { "source": "Содержание", "transform": "string", "verify": true },
                  "product_code": {
                    "source": "Номенклатура_Key", "transform": "string", "verify": true,
                    "lookup": { "resource": "Catalog_Номенклатура", "properties": [ "Артикул" ] }
                  },
                  "quantity": { "source": "Количество", "transform": "decimal", "verify": true },
                  "price": { "source": "Цена", "transform": "money", "verify": true },
                  "vat_rate": { "source": "СтавкаНДС", "transform": "vat_rate", "verify": true },
                  "amount": {
                    "source": "Сумма", "vat_source": "СуммаНДС", "header_flag": "СуммаВключаетНДС",
                    "transform": "amount_with_vat", "verify": true
                  }
                }
              }
            ]
          }
        },
        {
          "resource": { "name": "Document_ПоступлениеТоваровУслуг", "verify": true },
          "date_property": { "name": "Date", "verify": false },
          "organization_filter": { "value": "Организация_Key eq {organization}", "verify": true },
          "fields": {
            "doc_kind": { "const": "Purchase", "verify": false },
            "doc_type": { "const": "ПоступлениеТоваровУслуг", "verify": true },
            "number": { "source": "Number", "transform": "string", "verify": false },
            "date": { "source": "Date", "transform": "date", "verify": false },
            "posted": { "source": "Posted", "transform": "bool", "verify": false },
            "counterparty_ref": { "source": "Контрагент_Key", "transform": "ref", "verify": true },
            "contract_ref": { "source": "ДоговорКонтрагента_Key", "transform": "ref", "verify": true },
            "contract_number": {
              "source": "ДоговорКонтрагента_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_ДоговорыКонтрагентов", "properties": [ "Номер", "Description" ] }
            },
            "contract_date": {
              "source": "ДоговорКонтрагента_Key", "transform": "date", "verify": true,
              "lookup": { "resource": "Catalog_ДоговорыКонтрагентов", "properties": [ "Дата" ] }
            },
            "currency": {
              "source": "ВалютаДокумента_Key", "transform": "currency", "verify": true,
              "lookup": { "resource": "Catalog_Валюты", "properties": [ "Description", "Code" ] }
            },
            "amount_total": { "source": "СуммаДокумента", "transform": "money", "verify": true },
            "vat_amount": {
              "transform": "money", "verify": true,
              "sum_of": [ { "table": "Товары", "property": "СуммаНДС" }, { "table": "Услуги", "property": "СуммаНДС" } ]
            },
            "comment": { "source": "Комментарий", "transform": "string", "max_length": 1000, "verify": true }
          },
          "children": {
            "name": "lines",
            "tables": [
              {
                "property": { "name": "Товары", "verify": true },
                "fields": {
                  "line_no": { "source": "LineNumber", "transform": "int", "verify": false },
                  "item_ref": { "source": "Номенклатура_Key", "transform": "ref", "verify": true },
                  "name": {
                    "source": "Номенклатура_Key", "transform": "string", "verify": true,
                    "lookup": { "resource": "Catalog_Номенклатура", "properties": [ "Description" ] }
                  },
                  "product_code": {
                    "source": "Номенклатура_Key", "transform": "string", "verify": true,
                    "lookup": { "resource": "Catalog_Номенклатура", "properties": [ "Артикул" ] }
                  },
                  "quantity": { "source": "Количество", "transform": "decimal", "verify": true },
                  "price": { "source": "Цена", "transform": "money", "verify": true },
                  "vat_rate": { "source": "СтавкаНДС", "transform": "vat_rate", "verify": true },
                  "amount": {
                    "source": "Сумма", "vat_source": "СуммаНДС", "header_flag": "СуммаВключаетНДС",
                    "transform": "amount_with_vat", "verify": true
                  }
                }
              },
              {
                "property": { "name": "Услуги", "verify": true },
                "fields": {
                  "line_no": { "source": "LineNumber", "transform": "int", "verify": false },
                  "item_ref": { "source": "Номенклатура_Key", "transform": "ref", "verify": true },
                  "name": { "source": "Содержание", "transform": "string", "verify": true },
                  "quantity": { "source": "Количество", "transform": "decimal", "verify": true },
                  "price": { "source": "Цена", "transform": "money", "verify": true },
                  "vat_rate": { "source": "СтавкаНДС", "transform": "vat_rate", "verify": true },
                  "amount": {
                    "source": "Сумма", "vat_source": "СуммаНДС", "header_flag": "СуммаВключаетНДС",
                    "transform": "amount_with_vat", "verify": true
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "entity": "bank_documents",
      "sources": [
        {
          "resource": { "name": "Document_ПоступлениеНаРасчетныйСчет", "verify": true },
          "date_property": { "name": "Date", "verify": false },
          "organization_filter": { "value": "Организация_Key eq {organization}", "verify": true },
          "fields": {
            "direction": { "const": "Receipt", "verify": false },
            "number": { "source": "Number", "transform": "string", "verify": false },
            "date": { "source": "Date", "transform": "date", "verify": false },
            "posted": { "source": "Posted", "transform": "bool", "verify": false },
            "bank_account_ref": { "source": "СчетОрганизации_Key", "transform": "ref", "verify": true },
            "bank_account_number": {
              "source": "СчетОрганизации_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_БанковскиеСчета", "properties": [ "НомерСчета" ] }
            },
            "counterparty_ref": { "source": "Контрагент", "only_type": "StandardODATA.Catalog_Контрагенты", "transform": "ref", "verify": true },
            "amount": { "source": "СуммаДокумента", "transform": "money", "verify": true },
            "currency": {
              "source": "ВалютаДокумента_Key", "transform": "currency", "verify": true,
              "lookup": { "resource": "Catalog_Валюты", "properties": [ "Description", "Code" ] }
            },
            "purpose": { "source": "НазначениеПлатежа", "transform": "string", "verify": true },
            "contract_ref": { "source": "ДоговорКонтрагента_Key", "transform": "ref", "verify": true },
            "bank_document_number": { "source": "НомерВходящегоДокумента", "transform": "string", "verify": true },
            "bank_document_date": { "source": "ДатаВходящегоДокумента", "transform": "date", "verify": true },
            "cash_flow_item": {
              "source": "СтатьяДвиженияДенежныхСредств_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_СтатьиДвиженияДенежныхСредств", "properties": [ "Description" ] }
            }
          },
          "children": {
            "name": "settlements",
            "tables": [
              {
                "property": { "name": "РасшифровкаПлатежа", "verify": true },
                "fields": {
                  "line_no": { "source": "LineNumber", "transform": "int", "verify": false },
                  "settled_document_ref": { "source": "Сделка", "transform": "ref", "verify": true },
                  "amount": { "source": "СуммаПлатежа", "transform": "money", "verify": true }
                }
              }
            ]
          }
        },
        {
          "resource": { "name": "Document_СписаниеСРасчетногоСчета", "verify": true },
          "date_property": { "name": "Date", "verify": false },
