            "number": { "source": "Number", "transform": "string", "verify": false },
            "date": { "source": "Date", "transform": "date", "verify": false },
            "posted": { "source": "Posted", "transform": "bool", "verify": false },
            "bank_account_ref": { "source": "СчетОрганизации_Key", "transform": "ref", "verify": true },
