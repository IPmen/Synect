              "source": "СчетОрганизации_Key", "transform": "string", "verify": true,
              "lookup": { "resource": "Catalog_БанковскиеСчета", "properties": [ "НомерСчета" ] }
            },
            "counterparty_ref": { "source": "Контрагент", "only_type": "StandardODATA.Catalog_Контрагенты", "transform": "ref", "verify": true },
            "amount": { "source": "СуммаДокумента", "transform": "money", "verify": true },
            "currency": {
              "source": "ВалютаДокумента_Key", "transform": "currency", "verify": true,
