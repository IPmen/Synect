{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Synect": "Host=localhost;Port=5432;Database=synect;Username=synect_app"
  },
  "Adapters": {
    "KapitalBank": {
      "AmountUnit": "Minor",
      "RateLimit": {
        "PerConnection": {
          "TokenLimit": 5,
          "TokensPerPeriod": 5,
          "ReplenishmentPeriod": "00:00:01"
        },
        "PerSource": {
          "TokenLimit": 20,
          "TokensPerPeriod": 20,
          "ReplenishmentPeriod": "00:00:01"
        }
      }
    },
    "Didox": {
      "SumUnit": "Major",
      "SourceUtcOffset": "05:00:00",
      "RateLimit": {
        "PerConnection": {
          "TokenLimit": 5,
          "TokensPerPeriod": 5,
          "ReplenishmentPeriod": "00:00:01"
        },
        "PerSource": {
          "TokenLimit": 20,
          "TokensPerPeriod": 20,
          "ReplenishmentPeriod": "00:00:01"
        }
      },
      "Token": {
        "TokenLifetime": "06:00:00",
        "RefreshMargin": "00:10:00"
      }
    }
  },
  "Sync": {
    "Bank": {
      "InitialDays": 30,
      "OperationalDayUtcOffset": "05:00:00"
    },
    "Edo": {
      "UpdatedSinceOverlap": "1.00:00:00"
    },
    "Queue": {
      "PollInterval": "00:00:10",
      "MaxConcurrent": 4,
      "DefaultMaxConcurrentPerSource": 2,
      "MaxConcurrentPerSource": {
        "KapitalBank": 2,
        "Didox": 2
      },
      "JobTimeout": "01:00:00",
      "HeartbeatInterval": "00:01:00",
      "HeartbeatTimeout": "00:10:00",
      "ManualRequestMinInterval": "00:05:00"
    },
    "Schedule": {
      "UtcOffset": "05:00:00",
      "NightlyWindowStart": "01:00:00",
      "NightlyWindowEnd": "05:00:00",
      "EdoDaytimeRefreshHours": 4,
      "DaytimeStart": "08:00:00",
      "DaytimeEnd": "20:00:00"
    },
    "Retry": {
      "MaxAttempts": 4,
      "BaseDelay": "00:00:01",
      "MaxDelay": "00:00:30"
    },
    "CircuitBreaker": {
      "FailureThreshold": 3
    }
  },
  "Secrets": {
    "KeysPath": ""
  },
  "Analytics": {
    "QueryTimeout": "00:00:05",
    "DefaultPageSize": 100,
    "MaxPageSize": 1000,
    "UtcOffset": "05:00:00",
    "Edo": {
      "CountedStatuses": [
        "1",
        "2",
        "3",
        "6",
        "8",
        "60"
      ],
      "Currency": "UZS"
    },
    "MaxParallelWorkersPerGather": 0
  },
  "Mcp": {
    "DefaultLimit": 50,
    "MaxLimit": 200,
    "MaxPeriodDays": 1827,
    "CallTimeout": "00:00:05",
    "MaskAccountNumbers": true,
    "UntrustedTextMaxLength": 300,
    "StaleAfter": "1.12:00:00",
    "RateLimit": {
      "RequestsPerMinutePerKey": 60,
      "MaxConcurrentPerTenant": 4,
      "Window": "00:01:00"
    }
  },
  "Search": {
    "MinSimilarity": 0.3,
    "DefaultPeriodMonths": 12,
    "MaxCandidates": 200,
    "BestMatchMargin": 0.15
  }
}
