{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Synect": "Host=localhost;Port=5432;Database=synect;Username=synect_app"
  },
  "Adapters": {
    "KapitalBank": {
      "AmountUnit": "Minor"
    },
    "Didox": {
      "SumUnit": "Major",
      "SourceUtcOffset": "05:00:00"
    }
  },
  "Sync": {
    "Bank": {
      "InitialDays": 30,
      "RefetchDays": 3
    },
    "Edo": {
      "UpdatedSinceOverlap": "1.00:00:00"
    }
  }
}